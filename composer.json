{
  "name": "apie/dataset",
  "description": "Composer package of the apie library: dataset",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Pieter Jordaan",
      "email": "pieter_jordaan@hotmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Apie\\Dataset\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Apie\\Tests\\Dataset\\": "tests/"
    }
  },
  "extra": {
    "apie-objects": [
      "Apie\\Dataset\\DummyApp\\Identifiers\\DummyUserIdentifier",
      "Apie\\Dataset\\DatasetIdentifier"
    ]
  },
  "require": {
    "php": ">=8.4",
    "apie/common": "self.version",
    "apie/core": "self.version",
    "apie/doctrine-entity-datalayer": "self.version",
    "apie/rest-api": "self.version",
    "apie/schema-generator": "self.version",
    "apie/serializer": "self.version",
    "devizzent/cebe-php-openapi": "^1.1.5",
    "psr/log": "^3.0",
    "symfony/cache": "^7.4",
    "symfony/dependency-injection": "^7.2",
    "symfony/event-dispatcher": "^7.2"
  },
  "require-dev": {
    "apie/faker": "self.version",
    "apie/fixtures": "self.version",
    "phpunit/phpunit": "^11.5.2",
    "phpspec/prophecy-phpunit": "^2.5"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}